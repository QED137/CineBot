# CineBot Environment Variables Template
# Copy this file to .env and fill in your actual values

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ENDPOINT=https://api.openai.com/v1/embeddings

# Neo4j Database
NEO4J_URI=neo4j+s://your_instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=your_instance_id
AURA_INSTANCENAME=Instance01

# HuggingFace
HF_TOKEN=your_huggingface_token_here

# TMDB & OMDB APIs
TMDB_API_KEY=your_tmdb_api_key_here
OMDB_API_KEY=your_omdb_api_key_here

# Flask
FLASK_SECRET_KEY=your_secret_key_for_production

# Model Configuration (optional)
TEXT_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VISION_EMBEDDING_MODEL_NAME=openai/clip-vit-base-patch32
