# Use Local Neo4j with Docker

# Copy this to .env for local development with Docker Neo4j
# This replaces the need for Neo4j Aura free tier

# ============================================
# LOCAL NEO4J (Docker)
# ============================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=cinebot123
NEO4J_DATABASE=neo4j

# ============================================
# REDIS (Local or Docker)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# OPENAI API
# ============================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ENDPOINT=https://api.openai.com/v1/embeddings

# ============================================
# HUGGINGFACE
# ============================================
HF_TOKEN=your_huggingface_token_here

# ============================================
# TMDB & OMDB APIs
# ============================================
TMDB_API_KEY=your_tmdb_api_key_here
OMDB_API_KEY=your_omdb_api_key_here

# ============================================
# FLASK (if using Flask)
# ============================================
FLASK_SECRET_KEY=your_secret_key_for_production

# ============================================
# MODEL CONFIGURATION (optional)
# ============================================
TEXT_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VISION_EMBEDDING_MODEL_NAME=openai/clip-vit-base-patch32
